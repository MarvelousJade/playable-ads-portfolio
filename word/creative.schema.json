{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Word Trails playable creative",
  "type": "object",
  "required": ["id", "title", "version", "timing", "variants"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "timing": {
      "type": "object",
      "required": ["hintDelayMs", "endCardDelayMs"],
      "properties": {
        "hintDelayMs": { "type": "integer", "minimum": 0 },
        "endCardDelayMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["hook", "instruction", "letters", "rows", "cols", "words", "endTitle", "endCopy"],
        "properties": {
          "hook": { "type": "string" },
          "instruction": { "type": "string" },
          "letters": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": { "type": "string", "pattern": "^[A-Z]$" }
          },
          "rows": { "type": "integer", "minimum": 1, "maximum": 12 },
          "cols": { "type": "integer", "minimum": 1, "maximum": 12 },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text", "cells"],
              "properties": {
                "text": { "type": "string", "pattern": "^[A-Z]+$" },
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "endTitle": { "type": "string" },
          "endCopy": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
